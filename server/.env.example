PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017/attendx

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI Key (for AI Timetable Scanner, Voice Assistant, AttendX AI)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Classroom OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:5000/api/classroom/callback

# Web Push VAPID Keys (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@attendx.app

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
